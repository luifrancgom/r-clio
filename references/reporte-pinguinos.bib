@incollection{sprenger_simpsons_2026,
	edition = {Summer 2026},
	title = {Simpson’s {Paradox}},
	url = {https://plato.stanford.edu/archives/sum2026/entries/paradox-simpson/},
	abstract = {Simpson’s Paradox is a statistical phenomenon where anassociation between two variables in a population emerges, disappearsor reverses when the population is divided into subpopulations. Forinstance, two variables may be positively associated in a population,but be independent or even negatively associated in allsubpopulations. Cases exhibiting the paradox are unproblematic fromthe perspective of mathematics and probability theory, butnevertheless strike many people as surprising. Additionally, theparadox has implications for a range of areas that rely onprobabilities, including decision theory, causal inference, andevolutionary biology. Finally, there are many instances of theparadox, including in epidemiology and in studies of discrimination,where understanding the paradox is essential for drawing the correctconclusions from the data.},
	urldate = {2026-11-17},
	booktitle = {The {Stanford} {Encyclopedia} of {Philosophy}},
	publisher = {Metaphysics Research Lab, Stanford University},
	author = {Sprenger, Jan and Weinberger, Naftali},
	editor = {Zalta, Edward N. and Nodelman, Uri},
	year = {2026},
	keywords = {causal models, causation: and manipulability, causation: counterfactual theories of, causation: probabilistic, decision theory, decision theory: causal, statistics, philosophy of},
	file = {SEP - Snapshot:/home/luifrancgom/Zotero/storage/32FYI3FX/paradox-simpson.html:text/html},
}

